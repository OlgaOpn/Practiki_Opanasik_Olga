"name":"server","value":"uvicorn"},{"name":"x-frame-options","value":"DENY"}],"content":{"size":400,"mimeType":"image/svg+xml","compression":828,"text":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\" role=\"img\" aria-label=\"Добрый город\"><rect width=\"48\" height=\"48\" rx=\"14\" fill=\"#4B2BB5\"/><path d=\"M10 25 24 12l14 13v12a3 3 0 0 1-3 3H13a3 3 0 0 1-3-3z\" fill=\"#FBF8F3\"/><path d=\"M24 35.5s-7.5-4.6-7.5-9.4a4 4 0 0 1 7.5-2 4 4 0 0 1 7.5 2c0 4.8-7.5 9.4-7.5 9.4z\" fill=\"#FF6F59\"/><circle cx=\"35\" cy=\"11\" r=\"4\" fill=\"#FFC93C\"/></svg>"},"headersSize":428,"bodySize":-428,"redirectURL":"","_transferSize":0},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":-1,"receive":1.02},"_frameref":"frame@58995ba40bbeeb43f105246df3075d0a","_monotonicTime":1795.291,"_resourceType":"image","serverIPAddress":"127.0.0.1","_serverPort":8000,"_securityDetails":{}},{"pageref":"page@42fb7bb60a0e1541a14abdedc075495d","startedDateTime":"2026-11-07T13:05:12.132Z","time":1.022,"request":{"method":"GET","url":"http://127.0.0.1:8000/static/dist/app.min.js?v=1794056113","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Referer","value":"http://127.0.0.1:8000/cabinet"}],"queryString":[{"name":"v","value":"1794056113"}],"headersSize":78,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"content-security-policy","value":"default-src 'self'; img-src 'self' data:; style-src 'self'; frame-ancestors 'none'"},{"name":"etag","value":"\"f03bde8dcd1f2e97d740f2943af3a2e9\""},{"name":"x-content-type-options","value":"nosniff"},{"name":"referrer-policy","value":"same-origin"},{"name":"accept-ranges","value":"bytes"},{"name":"content-length","value":"2919"},{"name":"date","value":"Sat, 07 Nov 2026 13:05:10 GMT"},{"name":"content-type","value":"text/javascript; charset=utf-8"},{"name":"last-modified","value":"Sat, 07 Nov 2026 12:55:13 GMT"},{"name":"server","value":"uvicorn"},{"name":"x-frame-options","value":"DENY"}],"content":{"size":2919,"mimeType":"text/javascript; charset=utf-8","compression":3365,"text":"(() => {\nconst rules = {\nlogin: v => /^[A-Za-z0-9._-]{3,24}$/.test(v.trim()) || 'Логин: 3–24 символа — латинские буквы, цифры, точка, дефис, подчёркивание',\nfull_name: v => /^[А-ЯЁа-яё]+(?:[ -][А-ЯЁа-яё]+)+$/.test(v.trim().replace(/\\s+/g, ' ')) || 'Укажите фамилию и имя русскими буквами',\nemail: v => /^[^@\\s]+@[^@\\s]+\\.[A-Za-zА-Яа-я]{2,}$/.test(v.trim()) || 'Почта в формате name@example.ru',\nphone: v => /^\\+7 \\(\\d{3}\\) \\d{3}-\\d{2}-\\d{2}$/.test(v.trim()) || 'Телефон в формате +7 (999) 123-45-67',\npassword: v => (v.length >= 8 && /[A-Za-zА-Яа-яЁё]/.test(v) && /\\d/.test(v) && v === v.trim()) || 'Пароль — от 8 символов, буквы и цифры, без пробелов по краям',\npassword2: v => v === (document.getElementById('password') || {}).value || 'Пароли не совпадают',\naction_id: v => v !== '' || 'Выберите акцию',\ntask: v => v !== '' || 'Выберите, чем хотите помочь',\nrating: v => v !== '' || 'Поставьте оценку от 1 до 5',\nbody: v => v.trim().length >= 10 || 'Отзыв — от 10 до 1000 символов',\n};\nconst valueOf = (form, el) => el.type === 'radio'\n? (form.querySelector(`input[name=\"${el.name}\"]:checked`) || { value: '' }).value\n: el.value;\nconst check = (form, el) => {\nconst rule = rules[el.name];\nif (!rule) return true;\nconst res = rule(valueOf(form, el));\nconst box = el.closest('.field');\nbox.classList.toggle('field--error', res !== true);\nbox.querySelector('.field__err').textContent = res === true ? '' : res;\nreturn res === true;\n};\nconst phone = document.getElementById('phone');\nif (phone) phone.addEventListener('input', () => {\nlet d = phone.value.replace(/\\D/g, '');\nif (d.startsWith('8') || d.startsWith('7')) d = d.slice(1);\nd = d.slice(0, 10);\nconst p = [d.slice(0, 3), d.slice(3, 6), d.slice(6, 8), d.slice(8, 10)];\nphone.value = d ? '+7 (' + p[0] + (d.length > 3 ? ') ' + p[1] : '') + (d.length > 6 ? '-' + p[2] : '') + (d.length > 8 ? '-' + p[3] : '') : '';\n});\ndocument.querySelectorAll('form[data-validate]').forEach(form => {\nconst fields = [...form.querySelectorAll('input:not([type=hidden]), select, textarea')];\nfields.forEach(el => {\nel.addEventListener(el.type === 'radio' ? 'change' : 'blur', () => check(form, el));\nel.addEventListener('input', () => { if (el.closest('.field--error')) check(form, el); });\n});\nform.addEventListener('submit', e => {\nconst seen = new Set();\nconst bad = fields.filter(el => {\nif (seen.has(el.name)) return false;\nseen.add(el.name);\nreturn !check(form, el);\n});\nif (bad.length) { e.preventDefault(); bad[0].focus(); }\n});\n});\ndocument.querySelectorAll('form[data-confirm]').forEach(f =>\nf.addEventListener('submit', e => { if (!confirm(f.dataset.confirm)) e.preventDefault(); }));\n})();"},"headersSize":446,"bodySize":-446,"redirectURL":"","_transferSize":0},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":-1,"receive":1.022},"_frameref":"frame@58995ba40bbeeb43f105246df3075d0a","_monotonicTime":1795.785,"_resourceType":"script","serverIPAddress":"127.0.0.1","_serverPort":8000,"_securityDetails":{}},{"pageref":"page@42fb7bb60a0e1541a14abdedc075495d","startedDateTime":"2026-11-07T13:05:12.135Z","time":1.043,"request":{"method":"GET","url":"http://127.0.0.1:8000/static/fonts/lora-var.woff","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Referer","value":""}],"queryString":[],"headersSize":53,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"content-security-policy","value":"default-src 'self'; img-src 'self' data:; style-src 'self'; frame-ancestors 'none'"},{"name":"etag","value":"\"6741764f11b2d5da60d0229adb03f433\""},{"name":"x-content-type-options","value":"nosniff"},{"name":"referrer-policy","value":"same-origin"},{"name":"accept-ranges","value":"bytes"},{"name":"content-length","value":"58964"},{"name":"date","value":"Sat, 07 Nov 2026 13
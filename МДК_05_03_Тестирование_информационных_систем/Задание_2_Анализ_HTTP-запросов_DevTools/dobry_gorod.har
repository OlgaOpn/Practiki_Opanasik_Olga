rt\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n  <meta name=\"theme-color\" content=\"#FBF8F3\">\n  <title>Личный кабинет — Добрый город</title>\n  <link rel=\"icon\" href=\"/static/img/logo.svg\" type=\"image/svg+xml\">\n  <link rel=\"preload\" href=\"/static/fonts/inter-400.woff\" as=\"font\" type=\"font/woff\" crossorigin>\n  <link rel=\"stylesheet\" href=\"/static/dist/app.min.css?v=1794056113\">\n</head>\n<body>\n\n<header class=\"top\">\n  <div class=\"wrap top__row\">\n    <a class=\"logo\" href=\"/\"><img src=\"/static/img/logo.svg\" alt=\"\" width=\"40\" height=\"40\"><div><b>Добрый город</b><span>волонтёрские акции Москвы</span></div></a>\n    <nav class=\"nav\" aria-label=\"Основное меню\">\n      <a href=\"/\" >Акции</a>\n      \n        <a href=\"/cabinet\" aria-current=\"page\">Личный кабинет</a>\n        <a href=\"/signup\" >Записаться</a>\n      \n      \n        <div class=\"nav__user\">\n          <span class=\"avatar\" title=\"Набиев Тимур\">Т</span>\n          <form method=\"post\" action=\"/logout\"><input type=\"hidden\" name=\"csrf_token\" value=\"ryXdS3SJV77YSdmprn9arLueCL-QCJ5wmln0q2aNQ78\"><button type=\"submit\">Выйти</button></form>\n        </div>\n      \n    </nav>\n    \n  </div>\n</header>\n\n<main class=\"page\">\n  <div class=\"wrap\">\n    \n    \n<section class=\"profile\">\n  <span class=\"avatar\">Т</span>\n  <div><h1>Набиев Тимур</h1><p>timur_n · timur.nabiev@yandex.ru · +7 (903) 227-64-81</p></div>\n  <div class=\"profile__stats\">\n    <div><b>2</b><span>заявок</span></div>\n    <div><b>1</b><span>акций завершено</span></div>\n    <div><b>0</b><span>отзывов</span></div>\n  </div>\n</section>\n<div class=\"section-head\"><h2>Мои заявки</h2><a class=\"btn btn--sm\" href=\"/signup\">+ Записаться на акцию</a></div>\n\n<div class=\"list\">\n  \n  <article class=\"ticket\">\n    <span class=\"date\"><b>9</b><span>янв</span></span>\n    <div>\n      <h3>Помощь на благотворительном забеге «5 км добра»</h3>\n      <p class=\"ticket__meta\"><span>Москва, Парк Горького, Пушкинская набережная</span><span>Задача: Встреча и регистрация участников</span><span>Заявка № 4</span></p>\n      \n<ol class=\"steps\" aria-label=\"Статус заявки: Назначено\">\n  <li class=\"done\">Новая</li><li class=\"done\">Назначено</li><li class=\"\">Завершено</li>\n</ol>\n\n      \n    </div>\n    <div class=\"ticket__side\">\n      <span class=\"badge st-2\">Назначено</span>\n      \n    </div>\n  </article>\n  \n  <article class=\"ticket\">\n    <span class=\"date\"><b>31</b><span>окт</span></span>\n    <div>\n      <h3>Сбор корма для приюта «Верный друг»</h3>\n      <p class=\"ticket__meta\"><span>Москва, ул. Бутлерова, 12, пункт сбора</span><span>Задача: Логистика и доставка</span><span>Заявка № 3</span></p>\n      \n<ol class=\"steps\" aria-label=\"Статус заявки: Завершено\">\n  <li class=\"done\">Новая</li><li class=\"done\">Назначено</li><li class=\"done\">Завершено</li>\n</ol>\n\n      \n    </div>\n    <div class=\"ticket__side\">\n      <span class=\"badge st-3\">Завершено</span>\n      \n        <a class=\"btn btn--sun btn--sm\" href=\"/signups/3/review\">Оставить отзыв</a>\n      \n    </div>\n  </article>\n  \n</div>\n\n\n  </div>\n</main>\n\n<footer class=\"foot\">\n  <div class=\"wrap foot__row\">\n    <div><b>Добрый город</b><br>Помогаем вместе — по выходным и после работы.</div>\n    <div>Учебный проект · 2026</div>\n  </div>\n</footer>\n\n<nav class=\"tabbar\" aria-label=\"Меню для смартфона\">\n  <a href=\"/\" ><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 11 12 4l8 7v8a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z\"/></svg>Акции</a>\n  \n    <a href=\"/cabinet\" aria-current=\"page\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"rou
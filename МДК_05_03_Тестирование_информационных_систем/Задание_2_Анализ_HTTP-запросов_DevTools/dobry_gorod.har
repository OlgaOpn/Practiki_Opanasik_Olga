img/logo.svg\" alt=\"\" width=\"40\" height=\"40\"><div><b>Добрый город</b><span>волонтёрские акции Москвы</span></div></a>\n    <nav class=\"nav\" aria-label=\"Основное меню\">\n      <a href=\"/\" >Акции</a>\n      \n      \n        <a href=\"/login\" aria-current=\"page\">Вход</a>\n        <a class=\"btn btn--sun btn--sm\" href=\"/register\">Стать волонтёром</a>\n      \n    </nav>\n    <a class=\"btn btn--sun btn--sm top__login\" href=\"/login\">Войти</a>\n  </div>\n</header>\n\n<main class=\"page\">\n  <div class=\"wrap\">\n    \n    \n<div class=\"auth\">\n  <div class=\"auth__art\">\n    <div><h2>С возвращением!</h2><p>Войдите, чтобы записаться на акцию или посмотреть статус своих заявок.</p></div>\n    <img src=\"/static/img/hero.svg\" alt=\"\" width=\"520\" height=\"380\">\n  </div>\n  <form method=\"post\" class=\"auth__form\">\n    <h1>Вход</h1>\n    \n    <input type=\"hidden\" name=\"csrf_token\" value=\"qOZIlqZqNvLj-D93oMWs9Uu-77mAIODrkOgul5Z4bl8\">\n    <div class=\"field\"><label for=\"login\">Логин</label><input id=\"login\" name=\"login\" value=\"\" required autocomplete=\"username\"></div>\n    <div class=\"field\"><label for=\"password\">Пароль</label><input id=\"password\" name=\"password\" type=\"password\" required autocomplete=\"current-password\"></div>\n    <div class=\"form-foot\"><button class=\"btn\" type=\"submit\">Войти</button><span class=\"muted\">Нет аккаунта? <a href=\"/register\">Регистрация</a></span></div>\n  </form>\n</div>\n\n  </div>\n</main>\n\n<footer class=\"foot\">\n  <div class=\"wrap foot__row\">\n    <div><b>Добрый город</b><br>Помогаем вместе — по выходным и после работы.</div>\n    <div>Учебный проект · 2026</div>\n  </div>\n</footer>\n\n<nav class=\"tabbar\" aria-label=\"Меню для смартфона\">\n  <a href=\"/\" ><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 11 
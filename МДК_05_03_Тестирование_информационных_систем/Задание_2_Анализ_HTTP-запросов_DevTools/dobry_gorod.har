\";src:url(\"../fonts/inter-400.woff\") format(\"woff\");font-weight:400;font-display:swap}@font-face{font-family:\"Inter\";src:url(\"../fonts/inter-600.woff\") format(\"woff\");font-weight:600;font-display:swap}@font-face{font-family:\"Inter\";src:url(\"../fonts/inter-700.woff\") format(\"woff\");font-weight:700;font-display:swap}:root{--violet:#4B2BB5;--violet-deep:#2A1873;--violet-soft:#EDE7FF;--violet-line:#DCD3FA;--sun:#FFC93C;--sun-soft:#FFF4D1;--coral:#FF6F59;--coral-ink:#C2412F;--coral-soft:#FFE6E1;--mint:#1FA67A;--mint-ink:#127A58;--mint-soft:#DDF5EC;--sky:#2E6FDB;--sky-soft:#E2ECFC;--milk:#FBF8F3;--paper:#FFFFFF;--ink:#1E1B2E;--ink-2:#5D5873;--line:#ECE6F2;--radius:20px;--radius-sm:12px;--shadow:0 1px 2px rgba(42,24,115,.06),0 10px 30px rgba(42,24,115,.07);--serif:\"Lora\",Georgia,\"Times New Roman\",serif;--sans:\"Inter\",system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}*,*::before,*::after{box-sizing:border-box}html{-webkit-text-size-adjust:100%}body{margin:0;min-height:100vh;display:flex;flex-direction:column;font:16px/1.55 var(--sans);color:var(--ink);background:var(--milk)}img,svg{display:block;max-width:100%}a{color:var(--violet);text-underline-offset:3px}h1,h2,h3{font-family:var(--serif);font-weight:600;line-height:1.15;letter-spacing:-.01em;margin:0 0 .4em}h1{font-size:clamp(30px,4.4vw,46px)}h2{font-size:clamp(22px,2.6vw,28px)}h3{font-size:19px}em.accent{font-style:italic;color:var(--violet)}.wrap{width:min(1160px,100% - 40px);margin-inline:auto}:focus-visible{outline:3px solid var(--sun);outline-offset:2px;border-radius:6px}.top{position:sticky;top:0;z-index:30;background:rgba(251,248,243,.9);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}.top__row{display:flex;align-items:center;gap:24px;height:72px}.logo{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--ink)}.logo img{width:40px;height:40px}.logo b{font:700 20px/1 var(--serif)}.logo span{display:block;font-size:12px;color:var(--ink-2);font-weight:400;margin-top:3px}.nav{display:flex;align-items:center;gap:4px;margin-left:auto}.nav a,.nav button{padding:9px 14px;border-radius:999px;color:var(--ink);text-decoration:none;font-weight:600;font-size:15px;background:none;border:0;font-family:inherit;cursor:pointer;transition:background .2s,color .2s}.nav a:hover,.nav button:hover{background:var(--violet-soft);color:var(--violet)}.nav a[aria-current=\"page\"]{background:var(--violet);color:#fff}.nav form{margin:0}.nav__user{display:flex;align-items:center;gap:8px;padding-left:10px;margin-left:6px;border-left:1px solid var(--line)}.avatar{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;font-weight:700;font-size:14px;background:var(--sun);color:var(--violet-deep)}.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:0 22px;border-radius:999px;border:2px solid transparent;font:600 16px/1 var(--sans);text-decoration:none;cursor:pointer;background:var(--violet);color:#fff;transition:transform .15s,box-shadow .2s,background .2s}.btn:hover{transform:translateY(-1px);box-shadow:0 8px 20px rgba(75,43,181,.28)}.btn:active{transform:translateY(1px) scale(.98);box-shadow:none}.btn--sun{background:var(--sun);color:var(--violet-deep)}.btn--sun:hover{box-shadow:0 8px 20px rgba(255,201,60,.45)}.btn--ghost{background:transparent;color:var(--violet);border-color:var(--violet-line)}.btn--ghost:hover{background:var(--violet-soft);box-shadow:none}.btn--danger{background:transparent;color:var(--coral-ink);border-color:#F6C4BB}.btn--danger:hover{background:var(--coral-soft);box-shadow:none}.btn--sm{min-height:40px;padding:0 16px;font-size:14px}.btn--block{width:100%}.toast{display:flex;gap:10px;align-items:flex-start;padding:14px 18px;border-radius:var(--radius-sm);margin:0 0 18px;font-weight:600;background:var(--violet-soft);color:var(--violet-deep)}.toast::before{content:\"✦\"}.toast--ok{background:var(--mint-soft);color:var(--mint-ink)}.toast--ok::before{content:\"✓\"}.toast--error{background:var(--coral-soft);color:var(--coral-ink)}.toast--error::before{content:\"!\"}.page{flex:1;padding:36px 0 72px}.hero{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:40px;align-items:center;margin-bottom:48px}.hero__kicker{display:inline-flex;gap:8px;align-items:center;padding:6px 14px;border-radius:999px;background:var(--sun-soft);color:#8A5A00;font-weight:700;font-size:13px;letter-spacing:.04em;text-transform:uppercase}.hero h1{margin-top:16px}.hero p{font-size:18px;color:var(--ink-2);max-width:520px}.hero__cta{display:flex;flex-wrap:wrap;gap:12px;margin:26px 0 30px}.stats{display:flex;flex-wrap:wrap;gap:14px 28px;padding:0;margin:0;list-style:none}.stats b{display:block;font:600 30px/1 var(--serif);color:var(--violet)}.stats span{font-size:14px;color:var(--ink-2)}.section-head{display:flex;justify-content:space-between;align-items:end;gap:16px;flex-wrap:wrap;margin-bottom:18px}.chips{display:flex;gap:8px;flex-wrap:wrap;padding:0;margin:0;list-style:none}.chip{display:inline-flex;align-items:center;gap:6px;min-height:40px;padding:0 16px;border-radius:999px;text-decoration:none;font-weight:600;font-size:14px;color:var(--ink);background:var(--paper);border:1px solid var(--line);transition:all .2s}.chip svg{width:18px;height:18px}.chip:hover{border-color:var(--violet-line);color:var(--violet)}.chip.is-active{background:var(--ink);color:#fff;border-color:var(--ink)}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:22px}.card{position:relative;display:flex;flex-direction:column;background:var(--paper);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden;transition:transform .25s,box-shadow .25s}.card:hover{transform:translateY(-4px);box-shadow:0 2px 4px rgba(42,24,115,.06),0 18px 40px rgba(42,24,115,.12)}.card__band{display:flex;justify-content:space-between;align-items:center;padding:16px 20px}.card__cat{display:inline-flex;align-items:center;gap:8px;font-weight:700;font-size:
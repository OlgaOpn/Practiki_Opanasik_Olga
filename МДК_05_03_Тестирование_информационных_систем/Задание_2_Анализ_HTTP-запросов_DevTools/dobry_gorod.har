;top:0;z-index:30;background:rgba(251,248,243,.9);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}.top__row{display:flex;align-items:center;gap:24px;height:72px}.logo{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--ink)}.logo img{width:40px;height:40px}.logo b{font:700 20px/1 var(--serif)}.logo span{display:block;font-size:12px;color:var(--ink-2);font-weight:400;margin-top:3px}.nav{display:flex;align-items:center;gap:4px;margin-left:auto}.nav a,.nav button{padding:9px 14px;border-radius:999px;color:var(--ink);text-decoration:none;font-weight:600;font-size:15px;background:none;border:0;font-family:inherit;cursor:pointer;transition:background .2s,color .2s}.nav a:hover,.nav button:hover{background:var(--violet-soft);color:var(--violet)}.nav a[aria-current=\"page\"]{background:var(--violet);color:#fff}.nav form{margin:0}.nav__user{display:flex;align-items:center;gap:8px;padding-left:10px;margin-left:6px;border-left:1px solid var(--line)}.avatar{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;font-weight:700;font-size:14px;background:var(--sun);color:var(--violet-deep)}.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:0 22px;border-radius:999px;border:2px solid transparent;font:600 16px/1 var(--sans);text-decoration:none;cursor:pointer;background:var(--violet);color:#fff;transition:transform .15s,box-shadow .2s,background .2s}.btn:hover{transform:translateY(-1px);box-shadow:0 8px 20px rgba(75,43,181,.28)}.btn:active{transform:translateY(1px) scale(.98);box-shadow:none}.btn--sun{background:var(--sun);color:var(--violet-deep)}.btn--sun:hover{box-shadow:0 8px 20px rgba(255,201,60,.45)}.btn--ghost{background:transparent;color:var(--violet);border-color:var(--violet-line)}.btn--ghost:hover{background:var(--violet-soft);box-shadow:none}.btn--danger{background:transparent;color:var(--coral-ink);border-color:#F6C4BB}.btn--danger:hover{background:var(--coral-soft);b
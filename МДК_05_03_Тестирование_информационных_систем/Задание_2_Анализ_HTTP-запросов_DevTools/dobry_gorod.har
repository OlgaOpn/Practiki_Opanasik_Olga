{"log":{"version":"1.2","creator":{"name":"Playwright","version":"1.63.0"},"browser":{"name":"chromium","version":"153.0.8010.12"},"pages":[{"startedDateTime":"2026-11-07T13:05:10.779Z","id":"page@42fb7bb60a0e1541a14abdedc075495d","title":"Ошибка 404 — Добрый город","pageTimings":{"onContentLoad":1745,"onLoad":1746}}],"entries":[{"pageref":"page@42fb7bb60a0e1541a14abdedc075495d","startedDateTime":"2026-11-07T13:05:10.785Z","time":18.141000000000002,"request":{"method":"GET","url":"http://127.0.0.1:8000/","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"127.0.0.1:8000"},{"name":"Sec-Fetch-Dest","value":"document"},{"name":"Sec-Fetch-Mode","value":"navigate"},{"name":"Sec-Fetch-Site","value":"none"},{"name":"Sec-Fetch-User","value":"?1"},{"name":"Upgrade-Insecure-Requests","value":"1"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/153.0.8010.12 Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""}],"queryString":[],"headersSize":629,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[{"name":"dg_session","value":"eyJjc3JmIjogInFPWklscVpxTnZMai1EOTNvTVdzOVV1LTc3bUFJT0Rya09ndWw1WjRibDgifQ==.au8iBg.-vL7lSU5cncTDvPgFEWF2qfPylg","path":"/","expires":"2026-11-07T15:05:10.809Z","httpOnly":true,"sameSite":"lax"}],"headers":[{"name":"content-length","value":"12596"},{"name":"content-security-policy","value":"default-src 'self'; img-src 'self' data:; style-src 'self'; frame-ancestors 'none'"},{"name":"content-type","value":"text/html; charset=utf-8"},{"name":"date","value":"Sat, 07 Nov 2026 13:05:10 GMT"},{"name":"referrer-policy","value":"same-origin"},{"name":"server","value":"uvicorn"},{"name":"set-cookie","value":"dg_session=eyJjc3JmIjogInFPWklscVpxTnZMai1EOTNvTVdzOVV1LTc3bUFJT0Rya09ndWw1WjRibDgifQ==.au8iBg.-vL7lSU5cncTDvPgFEWF2qfPylg; path=/; Max-Age=7200; httponly; samesite=lax"},{"name":"vary","value":"Cookie"},{"name":"x-content-type-options","value":"nosniff"},{"name":"x-frame-options","value":"DENY"}],"content":{"size":12596,"mimeType":"text/html; charset=utf-8","compression":0,"text":"<!doctype html>\n<html lang=\"ru\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n  <meta name=\"theme-color\" content=\"#FBF8F3\">\n  <title>Добрый город — волонтёрские акции Москвы</title>\n  <link rel=\"icon\" href=\"/static/img/logo.svg\" type=\"image/svg+xml\">\n  <link rel=\"preload\" href=\"/static/fonts/inter-400.woff\" as=\"font\" type=\"font/woff\" crossorigin>\n  <link rel=\"stylesheet\" href=\"/static/dist/app.min.css?v=1794056113\">\n</head>\n<body>\n\n<header class=\"top\">\n  <div class=\"wrap top__row\">\n    <a class=\"logo\" href=\"/\"><img src=\"/static/img/logo.svg\" alt=\"\" width=\"40\" height=\"40\"><div><b>Добрый город</b><span>волонтёрские акции Москвы</span></div></a>\n    <nav class=\"nav\" aria-label=\"Основное меню\">\n      <a href=\"/\" aria-current=\"page\">Акции</a>\n      \n      \n        <a href=\"/login\" >Вход</a>\n        <a class=\"btn btn--sun btn--sm\" href=\"/register\">Стать волонтёром</a>\n      \n    </nav>\n    <a class=\"btn btn--sun btn--sm top__login\" href=\"/login\">Войти</a>\n  </div>\n</header>\n\n<main class=\"page\">\n  <div class=\"wrap\">\n    \n    \n<section class=\"hero\">\n  <div>\n    <span class=\"hero__kicker\">✦ Волонтёрство рядом с домом</span>\n    <h1>Делать город лучше — <em class=\"accent\">проще, чем кажется</em></h1>\n    <p>Субботники, помощь приютам, праздники для детей и пожилых. Выберите акцию, запишитесь в пару кликов — координатор свяжется с вами.</p>\n    <div class=\"hero__cta\">\n      <a class=\"btn btn--sun\" href=\"/register\">Стать волонтёром</a>\n      <a class=\"btn btn--ghost\" href=\"#actions\">Смотреть акции</a>\n    </div>\n    <ul class=\"stats\">\n      <li><b>4</b><span>ближайших акций</span></li>\n      <li><b>3</b><span>волонтёров с нами</span></li>\n      <li><b>5</b><span>направлений помощи</span></li>\n    </ul>\n  </div>\n  <img class=\"hero__art\" src=\"/static/img/hero.svg\" alt=\"Волонтёры сажают дерево и несут коробку с помощью\" width=\"520\" height=\"380\">\n</section>\n\n<section id=\"actions\">\n  <div class=\"section-head\">\n    <h2>Ближайшие акции</h2>\n    <ul class=\"chips\" aria-label=\"Направления\">\n      <li><a class=\"chip is-active\" href=\"/#actions\">Все</a></li>\n      \n      <li><a class=\"chip \" href=\"/?category=%D0%AD%D0%BA%D0%BE%D0%BB%D0%BE%D0%B3%D0%B8%D1%8F#actions\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 25C7 14 14 7 26 6c0 12-6 19-16 19\"/><path d=\"M7 25l9-9\"/></svg>Экология</a></li>\n      \n      <li><a class=\"chip \" href=\"/?category=%D0%96%D0%B8%D0%B2%D0%BE%D1%82%D0%BD%D1%8B%D0%B5#actions\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"13\" r=\"2.6\"/><circle cx=\"14\" cy=\"8\" r=\"2.6\"/><circle cx=\"20\" cy=\"8\" r=\"2.6\"/><circle cx=\"25\" cy=\"13\" r=\"2.6\"/><path d=\"M11 23c0-4 3-7 6-7s6 3 6 7c0 2.5-2 3.5-3.5 3l-2.5-1-2.5 1C13 27 11 26 11 23z\"/></svg>Животные</a></li>\n      \n      <li><a class=\"chip \" href=\"/?category=%D0%94%D0%B5%D1%82%D0%B8#actions\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M16 4a7 7 0 0 1 7 7c0 5.5-4 9.2-7 10-3-.8-7-4.5-7-10a7 7 0 0 1 7-7z\"/><path d=\"M14.6 21.6 16 23.4l1.4-1.8\"/><path d=\"M16 23.4c0 2.6-3 2.8-3 5.6\"/><path d=\"M13 9a3.5 3.5 0 0 1 2.5-2\"/></svg>Дети</a></li>\n      \n      <li><a class=\"chip \" href=\"/?category=%D0%9F%D0%BE%D0%B6%D0%B8%D0%BB%D1%8B%D0%B5%20%D0%BB%D1%8E%D0%B4%D0%B8#actions\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 13h15v6a7 7 0 0 1-7 7h-1a7 7 0 0 1-7-7z\"/><path d=\"M22 15h2a3 3 0 0 1 0 6h-2\"/><path d=\"M11 5c0 2 2 2 2 4M16 5c0 2 2 2 2 4\"/></svg>Пожилые люди</a></li>\n      \n      <li><a class=\"chip \" href=\"/?category=%D0%93%D0%BE%D1%80%D0%BE%D0%B4#actions\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 27h24\"/><path d=\"M7 27V12l6-4v19\"/><path d=\"M13 27V14h8v13\"/><path d=\"M21 27v-9h5v9\"/><path d=\"M16 18h2M16 22h2M9.5 15h1M9.5 19h1\"/></svg>Город</a></li>\n      \n    </ul>\n  </div>\n  \n  <div class=\"grid\">\n    \n\n<article class=\"card\">\n  <div class=\"card__band cat-eco\">\n    <span class=\"card__cat\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 25C7 14 14 7 26 6c0 12-6 19-16 19\"/><path d=\"M7 25l9-9\"/></svg>Экология</span>\n    <span class=\"date\"><b>21</b><span>ноя</span></span>\n  </div>\n  <div class=\"card__body\">\n    <h3><a href=\"/actions/3\">Посадка деревьев на ВДНХ</a></h3>\n    <p class=\"place\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z\"/><circle cx=\"12\" cy=\"9.5\" r=\"2.5\"/></svg>Москва, ВДНХ, Ботанический сад, южный вход</p>\n    <p class=\"card__text\">Сажаем 120 саженцев липы и клёна вместе с дендрологами. Подойдёт без опыта.</p>\n    <div class=\"card__foot\">\n      \n<label class=\"meter\">Записалось 1 из 40<progress max=\"40\" value=\"1\"></progress></label>\n\n      \n        <a class=\"btn btn--block\" href=\"/signup?action=3\">Хочу помочь</a>\n      \n    </div>\n  </div>\n</article>\n\n<article class=\"card\">\n  <div class=\"card__band cat-kids\">\n    <span class=\"card__cat\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M16 4a7 7 0 0 1 7 7c0 5.5-4 9.2-7 10-3-.8-7-4.5-7-10a7 7 0 0 1 7-7z\"/><path d=\"M14.6 21.6 16 23.4l1.4-1.8\"/><path d=\"M16 23.4c0 2.6-3 2.8-3 5.6\"/><path d=\"M13 9a3.5 3.5 0 0 1 2.5-2\"/></svg>Дети</span>\n    <span class=\"date\"><b>28</b><span>ноя</span></span>\n  </div>\n  <div class=\"card__body\">\n    <h3><a href=\"/actions/4\">Мастерская для детей из центра «Солнце»</a></h3>\n    <p class=\"place\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z\"/><circle cx=\"12\" cy=\"9.5\" r=\"2.5\"/></svg>Москва, Каширское шоссе, 54, центр «Солнце»</p>\n    <p class=\"card__text\">Проводим творческую мастерскую: рисуем, лепим и собираем ёлочные игрушки.</p>\n    <div class=\"card__foot\">\n      \n<label class=\"meter\">Записалось 1 из 6<progress max=\"6\" value=\"1\"></progress></label>\n\n      \n        <a class=\"btn btn--block\" href=\"/signup?action=4\">Хочу помочь</a>\n      \n    </div>\n  </div>\n</article>\n\n<article class=\"card\">\n  <div class=\"card__band cat-elderly\">\n    <span class=\"card__cat\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 13h15v6a7 7 0 0 1-7 7h-1a7 7 0 0 1-7-7z\"/><path d=\"M22 15h2a3 3 0 0 1 0 6h-2\"/><path d=\"M11 5c0 2 2 2 2 4M16 5c0 2 2 2 2 4\"/></svg>Пожилые люди</span>\n    <span class=\"date\"><b>12</b><span>дек</span></span>\n  </div>\n  <div class=\"card__body\">\n    <h3><a href=\"/actions/5\">Новогодние открытки для дома престарелых</a></h3>\n    <p class=\"place\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z\"/><circle cx=\"12\" cy=\"9.5\" r=\"2.5\"/></svg>Москва, библиотека им. Некрасова</p>\n    <p class=\"card__text\">Пишем и рисуем открытки, а потом вместе поздравляем бабушек и дедушек.</p>\n    <div class=\"card__foot\">\n      \n<label class=\"meter\">Записалось 0 из 15<progress max=\"15\" value=\"0\"></progress></label>\n\n      \n        <a class=\"btn btn--block\" href=\"/signup?action=5\">Хочу помочь</a>\n      \n    </div>\n  </div>\n</article>\n\n<article class=\"card\">\n  <div class=\"card__band cat-city\">\n    <span class=\"card__cat\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 27h24\"/><path d=\"M7 27V12l6-4v19\"/><path d=\"M13 27V14h8v13\"/><path d=\"M21 27v-9h5v9\"/><path d=\"M16 18h2M16 22h2M9.5 15h1M9.5 19h1\"/></svg>Город</span>\n    <span class=\"date\"><b>9</b><span>янв</span></span>\n  </div>\n  <div class=\"card__body\">\n    <h3><a href=\"/actions/6\">Помощь на благотворительном забеге «5 км добра»</a></h3>\n    <p class=\"place\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z\"/><circle cx=\"12\" cy=\"9.5\" r=\"2.5\"/></svg>Москва, Парк Горького, Пушкинская набережная</p>\n    <p class=\"card__text\">Встречаем бегунов, выдаём воду и стартовые пакеты, работаем на финише.</p>\n    <div class=\"card__foot\">\n      \n<label class=\"meter\">Записалось 1 из 30<progress max=\"30\" value=\"1\"></progress></label>\n\n      \n        <a class=\"btn btn--block\" href=\"/signup?action=6\">Хочу помочь</a>\n      \n    </div>\n  </div>\n</article>\n  </div>\n  \n</section>\n\n\n<section class=\"quotes\" aria-label=\"Отзывы волонтёров\">\n  \n  <blockquote class=\"quote\">\n    <span class=\"stars\" aria-label=\"Оценка 5 из 5\">★★★★★</span>\n    <p>«Отличная команда! За три часа убрали весь берег у Серебряного пруда, а в конце был горячий чай.»</p>\n    <footer>Соколова Варвара · Субботник в Измайловском парке</footer>\n  </blockquote>\n  \n</section>\n\n\n  </div>\n</main>\n\n<footer class=\"foot\">\n  <div class=\"wrap foot__row\">\n    <div><b>Добрый город</b><br>Помогаем вместе — по выходным и после работы.</div>\n    <div>Учебный проект · 2026</div>\n  </div>\n</footer>\n\n<nav class=\"tabbar\" aria-label=\"Меню для смартфона\">\n  <a href=\"/\" aria-current=\"page\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 11 12 4l8 7v8a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z\"/></svg>Акции</a>\n  \n  \n    <a href=\"/register\" ><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"8\"/><path d=\"M12 8v8M8 12h8\"/></svg>Регистрация</a>\n    <a href=\"/login\" ><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 20c1.5-4 4.5-6 8-6s6.5 2 8 6\"/></svg>Вход</a>\n  \n</nav>\n<script src=\"/static/dist/app.min.js?v=1794056113\" defer></script>\n</body>\n</html>"},"headersSize":527,"bodySize":12596,"redirectURL":"","_transferSize":13123},"cache":{},"timings":{"dns":0.038,"connect":0.16,"ssl":1.607,"send":0,"wait":13.694,"receive":2.642},"_frameref":"frame@58995ba40bbeeb43f105246df3075d0a","_monotonicTime":452.502,"_resourceType":"document","serverIPAddress":"127.0.0.1","_serverPort":8000,"_securityDetails":{}},{"pageref":"page@42fb7bb60a0e1541a14abdedc075495d","startedDateTime":"2026-11-07T13:05:10.814Z","time":52.943,"request":{"method":"GET","url":"http://127.0.0.1:8000/static/fonts/inter-400.woff","httpVersion":"HTTP/1.1","cookies":[{"name":"dg_session","value":"eyJjc3JmIjogInFPWklscVpxTnZMai1EOTNvTVdzOVV1LTc3bUFJT0Rya09ndWw1WjRibDgifQ==.au8iBg.-vL7lSU5cncTDvPgFEWF2qfPylg"}],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Cookie","value":"dg_session=eyJjc3JmIjogInFPWklscVpxTnZMai1EOTNvTVdzOVV1LTc3bUFJT0Rya09ndWw1WjRibDgifQ==.au8iBg.-vL7lSU5cncTDvPgFEWF2qfPylg"},{"name":"Host","value":"127.0.0.1:8000"},{"name":"Origin","value":"http://127.0.0.1:8000"},{"name":"Referer","value":"http://127.0.0.1:8000/"},{"name":"Sec-Fetch-Dest","value":"font"},{"name":"Sec-Fetch-Mode","value":"cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"Use
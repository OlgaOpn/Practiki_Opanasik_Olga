? '' : res;\nreturn res === true;\n};\nconst phone = document.getElementById('phone');\nif (phone) phone.addEventListener('input', () => {\nlet d = phone.value.replace(/\\D/g, '');\nif (d.startsWith('8') || d.startsWith('7')) d = d.slice(1);\nd = d.slice(0, 10);\nconst p = [d.slice(0, 3), d.slice(3, 6), d.slice(6, 8), d.slice(8, 10)];\nphone.value = d ? '+7 (' + p[0] + (d.length > 3 ? ') ' + p[1] : '') + (d.length > 6 ? '-' + p[2] : '') + (d.length > 8 ? '-' + p[3] : '') : '';\n});\ndocument.querySelectorAll('form[data-validate]').forEach(form => {\nconst fields = [...form.querySelectorAll('input:not([type=hidden]), select, textarea')];\nfields.forEach(el => {\nel.addEventListener(el.type === 'radio' ? 'change' : 'blur', () => check(form, el));\nel.addEventListener('input', () => { if (el.closest('.field--error')) check(form, el); });\n});\nform.addEventListener('submit', e => {\nconst seen = new Set();\nconst bad = fields.filter(el => {\nif (seen.has(el.name)) return false;\nseen.add(el.name);\nreturn !check(form, el);\n});\nif (bad.length) { e.preventDefault(); bad[0].focus(); }\n});\n});\ndocument.querySelectorAll('form[data-confirm]').forEach(f =>\nf.addEventListener('submit', e => { if (!confirm(f.dataset.confirm)) e.preventDefault(); }));\n})();"},"headersSize":446,"bodySize":-446,"redirectURL":"","_transferSize":0},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":-1,"receive":1.042},"_frameref":"frame@58995ba40bbeeb43f105246df3075d0a","_monotonicTime":2177.443,"_resourceType":"script","serverIPAddress":"127.0.0.1","_serverPort":8000,"_securityDetails":{}},{"pageref":"page@42fb7bb60a0e1541a14abdedc075495d","startedDateTime":"2026-11-07T13:05:12.524Z","time":1.048,"request":{"method":"GET","url":"http://127.0.0.1:8000/static/fonts/lora-var.woff","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Referer","value":""}],"queryString":[],"headersSize":53,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","co
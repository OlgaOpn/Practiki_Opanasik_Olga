aper);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden;transition:transform .25s,box-shadow .25s}.card:hover{transform:translateY(-4px);box-shadow:0 2px 4px rgba(42,24,115,.06),0 18px 40px rgba(42,24,115,.12)}.card__band{display:flex;justify-content:space-between;align-items:center;padding:16px 20px}.card__cat{display:inline-flex;align-items:center;gap:8px;font-weight:700;font-size:13px;letter-spacing:.03em;text-transform:uppercase}.card__cat svg{width:22px;height:22px}.date{text-align:center;line-height:1;background:var(--paper);border-radius:14px;padding:8px 10px;min-width:58px;color:var(--ink)}.date b{display:block;font:600 24px/1 var(--serif)}.date span{font-size:12px;text-transform:uppercase;color:var(--ink-2)}.card__body{padding:4px 22px 22px;display:flex;flex-direction:column;gap:10px;flex:1}.card__body h3{margin:6px 0 0}.card__body h3 a{color:inherit;text-decoration:none}.card__body h3 a:hover{color:var(--violet)}.place{display:flex;gap:6px;align-items:flex-start;color:var(--ink-2);font-size:14px;margin:0}.place svg{width:18px;height:18px;flex:none;margin-top:1px}.card__text{color:var(--ink-2);margin:0;font-size:15px}.card__foot{margin-top:auto;display:flex;flex-direction:column;gap:14px;padding-top:6px}.meter{display:grid;gap:6px;font-size:13px;color:var(--ink-2)}.meter progress{appearance:none;width:100%;height:8px;border:0;border-radius:99px;overflow:hidden;background:var(--violet-soft)}.meter progress::-webkit-progress-bar{background:var(--violet-soft);border-radius:99px}.meter progress::-webkit-progress-value{background:var(--violet);border-radius:99px}.meter progress::-moz-progress-bar{background:var(--violet);border-radius:99px}.cat-eco{background:var(--mint-soft);color:var(--mint-ink)}.cat-animals{background:var(--sun-soft);color:#8A5A00}.cat-kids{background:var(--coral-soft);color:var(--coral-ink)}.cat-elderly{background:var(--violet-soft);color:var(--violet)}.cat-city{background:var(--sky-soft);color:#1F55B0}.quotes{display:grid
 content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n  <meta name=\"theme-color\" content=\"#FBF8F3\">\n  <title>Запись на акцию — Добрый город</title>\n  <link rel=\"icon\" href=\"/static/img/logo.svg\" type=\"image/svg+xml\">\n  <link rel=\"preload\" href=\"/static/fonts/inter-400.woff\" as=\"font\" type=\"font/woff\" crossorigin>\n  <link rel=\"stylesheet\" href=\"/static/dist/app.min.css?v=1794056113\">\n</head>\n<body>\n\n<header class=\"top\">\n  <div class=\"wrap top__row\">\n    <a class=\"logo\" href=\"/\"><img src=\"/static/img/logo.svg\" alt=\"\" width=\"40\" height=\"40\"><div><b>Добрый город</b><span>волонтёрские акции Москвы</span></div></a>\n    <nav class=\"nav\" aria-label=\"Основное меню\">\n      <a href=\"/\" >Акции</a>\n      \n        <a href=\"/cabinet\" >Личный кабинет</a>\n        <a href=\"/signup\" aria-current=\"page\">Записаться</a>\n      \n      \n        <div class=\"nav__user\">\n          <span class=\"avatar\" title=\"Набиев Тимур\">Т</span>\n          <form method=\"post\" action=\"/logout\"><input type=\"hidden\" name=\"csrf_token\" value=\"ryXdS3SJV77YSdmprn9arLueCL-QCJ5wmln0q2aNQ78\"><button type=\"submit\">Выйти</button></form>\n        </div>\n      \n    </nav>\n    \n  </div>\n</header>\n\n<main class=\"page\">\n  <div class=\"wrap\">\n    \n    \n<form method=\"post\" class=\"panel panel--narrow\" novalidate data-validate>\n  <h1>Запись на акцию</h1>\n  <p class=\"muted\">Координатор подтвердит заявку и напишет вам на почту.</p>\n  <input type=\"hidden\" name=\"csrf_token\" value=\"ryXdS3SJV77YSdmprn9arLueCL-QCJ5wmln0q2aNQ78\">\n  <div class=\"field\">\n    <label for=\"action_id\">Акция</label>\n    <select id=\"action_id\" name=\"action_id\">\n      <option value=\"\">Выберите акцию</option>\n      <option value=\"3\" selected>21 ноября 2026 — Посадка деревьев на ВДНХ</option><option value=\"4\" >28 ноября 2026 — Мастерская для детей из центра «Солнце»</option><option value=\"5\" >12 декабря 2026 — Новогодние открытки для дома престарелых</option><option value=\"6\" >9 января 2027 — Помощь на благотворительном забеге «5 км добра»</option>\n    </select>\n    <span class=\"field__err\" role=\"alert\"></span>\n  </div>\n  <fieldset class=\"field\">\n    <legend>Чем хотите помочь</legend>\n    <div class=\"tiles\">\n      <label class=\"tile\"><input type=\"radio\" name=\"task\" value=\"Работа на площадке\" ><span>Работа на площадке</span></label><label class=\"tile\"><input type=\"radio\" name=\"task\" value=\"Встреча и регистрация участников\" ><span>Встреча и регистрация участников</span></label><label class=\"tile\"><input type=\"radio\" name=\"task\" value=\"Фото и соцсети\" ><span>Фото и соцсети</span></label><label class=\"tile\"><input type=\"radio\" name=\"task\" value=\"Логистика и доставка\" ><span>Логистика и доставка</span></label>\n    </div>\n    <span class=\"field__err\" role=\"alert\"></span>\n  </fieldset>\n  <div class=\"field\">\n    <label for=\"comment\">Комментарий <span class=\"muted\">(необязательно)</span></label>\n    <textarea id=\"comment\" name=\"comment\" maxlength=\"400\" placeholder=\"Например: есть машина, могу привезти инструменты\"></textarea>\n    <span class=\"field__err\" role=\"alert\"></span>\n  </div>\n  <div class=\"form-foot\"><button class=\"btn\" type=\"submit\">Отправить заявку</button><a class=\"muted\" href=\"/cabinet\">Отмена</a></div>\n</form>\n\n  </div>\n</main>\n\n<footer class=\"foot\">\n  <div class=\"wrap foot__row\">\n    <div><b>Добрый город</b><br>Помогаем вместе — по выходным и после работы.</div>\n    <div>Учебный проект · 2026</div>\n  </div>\n</footer>\n\n<nav class=\"tabbar\" aria-label=\"Меню для смартфона\">\n  <a href=\"/\" ><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 11 12 4l8 7v8a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z\"/></svg>Акции</a>